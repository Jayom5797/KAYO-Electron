{
  "name": "kayo-desktop",
  "version": "1.0.0",
  "description": "KAYO Security Workstation — Desktop application for security assessment, secure deployment, and runtime threat detection",
  "main": "main.js",
  "author": "KAYO Security",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env KAYO_MODE=development electron .",
    "build": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "io.kayo.security",
    "productName": "KAYO",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KAYO Security"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "staged-resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "staged-resources/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": "staged-resources/web",
        "to": "web",
        "filter": ["**/*"]
      }
    ]
  }
}
