# ═══════════════════════════════════════════════════════════════════════════════
# KAYO Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kayo:kayo_dev_password@localhost:5433/kayo_control_plane

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kayo_dev_password

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=kayo_events
CLICKHOUSE_USER=kayo
CLICKHOUSE_PASSWORD=kayo_dev_password

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=kayo-dev-secret-key-change-in-production

# ── AI (optional) ────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=

# ── AWS Deployment (optional) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Assessment Engine ─────────────────────────────────────────────────────────
ASSESSMENT_ENGINE_URL=http://localhost:4000
